{
  "manifest_version": 3,
  "name": "ChatGPT 提示词导航",
  "version": "1.3.0",
  "description": "左侧短横线导航：自动读取当前聊天的全部提问，大字悬浮预览，点击跳转。",
  "minimum_chrome_version": "114",
  "permissions": ["storage"],
  "action": {"default_title":"短横线颜色", "default_popup":"popup.html"},
  "icons": {"16":"icons/icon16.png","32":"icons/icon32.png","48":"icons/icon48.png","128":"icons/icon128.png"},
  "content_scripts": [{
    "matches": ["https://chatgpt.com/*","https://chat.openai.com/*"],
    "js": ["colors.js","history.js","navigation.js","styles.js","content.js"],
    "run_at": "document_idle"
  }]
}
